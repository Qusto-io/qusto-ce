        run: |
          first_line=$(printf '%s\n' "$COMMIT_MSG" | head -n1 | xargs)
          co_authors=$(printf '%s\n' "$COMMIT_MSG" | grep -h 'Co-authored-by:' | sort -u | cut -d: -f2- | paste -sd, - | xargs)
