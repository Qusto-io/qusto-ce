<.focus_box>
  <:title>Source Code Offer</:title>

  <div class="mb-8">
    <h1 class="text-4xl font-['Arbutus_Slab',Georgia,serif] text-[var(--color-heading)] dark:text-[var(--color-dark-heading)] mb-6">
      AGPL-3.0 Corresponding Source
    </h1>
    <p class="text-xl text-gray-600 dark:text-[var(--color-dark-text-secondary)] mb-6 leading-relaxed">
      Qusto Community Edition is free software under the
      <a
        href="https://www.gnu.org/licenses/agpl-3.0.html"
        class="text-[#1661be] dark:text-[#4a9eff] underline"
        target="_blank"
        rel="noopener noreferrer"
      >GNU Affero General Public License v3.0</a>.
      This page is the source offer required by AGPL §13 for anyone who uses this modified program over a network.
    </p>
  </div>

  <div class="bg-[#eeece2] dark:bg-[var(--color-dark-bg-base)] rounded-xl p-8 mb-12">
    <h2 class="text-2xl font-['Arbutus_Slab',Georgia,serif] text-[var(--color-heading)] dark:text-[var(--color-dark-heading)] mb-4">
      This build
    </h2>
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-gray-700 dark:text-[var(--color-dark-text-secondary)]">
      <div>
        <dt class="text-sm uppercase tracking-wide text-gray-500">Version</dt>
        <dd class="font-mono text-base"><%= @build[:version] || "unknown" %></dd>
      </div>
      <div>
        <dt class="text-sm uppercase tracking-wide text-gray-500">Commit</dt>
        <dd class="font-mono text-base break-all"><%= @build[:commit] || "unknown" %></dd>
      </div>
    </dl>
    <%= if @build[:commit] do %>
      <p class="mt-4">
        <a
          href={"https://github.com/Qusto-io/qusto-ce/tree/#{@build[:commit]}"}
          class="inline-flex items-center gap-2 text-[#1661be] dark:text-[#4a9eff] font-medium underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          View this commit on GitHub →
        </a>
      </p>
    <% end %>
    <p class="mt-2 text-sm text-gray-500">
      Live JSON: <code class="font-mono">GET /api/system</code>
    </p>
  </div>

  <div class="mb-12 space-y-4">
    <h2 class="text-2xl font-['Arbutus_Slab',Georgia,serif] text-[var(--color-heading)] dark:text-[var(--color-dark-heading)] mb-4">
      Where to get the source
    </h2>
    <ul class="list-disc pl-6 space-y-2 text-gray-700 dark:text-[var(--color-dark-text-secondary)]">
      <li>
        Public repository:
        <a href="https://github.com/Qusto-io/qusto-ce" class="text-[#1661be] dark:text-[#4a9eff] underline" target="_blank" rel="noopener noreferrer">
          github.com/Qusto-io/qusto-ce
        </a>
      </li>
      <li>
        License:
        <a href="https://github.com/Qusto-io/qusto-ce/blob/main/LICENSE.md" class="text-[#1661be] dark:text-[#4a9eff] underline" target="_blank" rel="noopener noreferrer">
          LICENSE.md (AGPL-3.0)
        </a>
      </li>
      <li>
        Marketing mirror of this offer:
        <a href="https://qusto.io/source/" class="text-[#1661be] dark:text-[#4a9eff] underline" target="_blank" rel="noopener noreferrer">
          qusto.io/source/
        </a>
      </li>
    </ul>
  </div>

  <div class="mb-12 space-y-4">
    <h2 class="text-2xl font-['Arbutus_Slab',Georgia,serif] text-[var(--color-heading)] dark:text-[var(--color-dark-heading)] mb-4">
      Written offer
    </h2>
    <p class="text-gray-700 dark:text-[var(--color-dark-text-secondary)]">
      If the public repository is unavailable, email
      <a href="mailto:legal@qusto.io" class="text-[#1661be] dark:text-[#4a9eff] underline">legal@qusto.io</a>
      (CC <a href="mailto:security@qusto.io" class="text-[#1661be] dark:text-[#4a9eff] underline">security@qusto.io</a>)
      with the version or commit above. We will provide Corresponding Source for at least three years after we last convey that version, at no more than our reasonable cost of physically performing source distribution.
    </p>
  </div>
</.focus_box>
